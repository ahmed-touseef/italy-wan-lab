[Unit]
Description=Italy WAN lab status collector (data for wan.touseefahmed.com)
After=docker.service
Wants=docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/italy-wan/collect.py --loop 15
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=always
RestartSec=10
Nice=10
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
